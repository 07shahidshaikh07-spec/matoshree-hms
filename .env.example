# ==============================================================================
# MATOSHREE CLINIC EMR — ENVIRONMENT CONFIGURATION (.env.example)
# Clinic: Matoshree Clinic, Latur, Maharashtra
# Doctors: Dr. Vinod Korale & Dr. Vaishali Korale
# ==============================================================================

# Option A: Local Development (SQLite - Zero setup)
# DATABASE_URL="file:./matoshree.db"

# Option B: Cloud Production (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Application Environment ("development" | "production" | "test")
NODE_ENV="development"

# Clinic Local Timezone (Locked to Indian Standard Time for Latur, Maharashtra)
TZ="Asia/Kolkata"
NEXT_PUBLIC_CLINIC_TIMEZONE="Asia/Kolkata"

# Session & Authentication Security
SESSION_SECRET="matoshree_clinic_latur_secure_crypto_secret_session_2026_key"
SESSION_EXPIRY_HOURS="12"

# Demo Mode Indicator ("false" for clean production state)
NEXT_PUBLIC_DEMO_MODE="false"
