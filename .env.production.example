# ==============================================================================
# MATOSHREE CLINIC EMR — PRODUCTION ENVIRONMENT VARIABLES (Render & Neon)
# Clinic: Matoshree Clinic, Latur, Maharashtra
# Doctors: Dr. Vinod Korale & Dr. Vaishali Korale
# ==============================================================================

# 1. NEON SERVERLESS POSTGRESQL CONNECTION STRING
# Get this from your Neon Console (https://console.neon.tech) -> Connection Details
# Select "Prisma" or "Connection string" (Pooled or Direct)
# Ensure ?sslmode=require is present at the end
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-solitary-snowflake-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. RUNTIME ENVIRONMENT
NODE_ENV="production"

# 3. CLINIC TIMEZONE (Indian Standard Time - Asia/Kolkata)
TZ="Asia/Kolkata"
NEXT_PUBLIC_CLINIC_TIMEZONE="Asia/Kolkata"

# 4. SESSION SECURITY KEY
# Any long random string for securing staff session tokens (Render generates this automatically if using render.yaml)
SESSION_SECRET="generate_a_secure_random_64_character_hex_string_here"
SESSION_EXPIRY_HOURS="12"

# 5. DEMO MODE
NEXT_PUBLIC_DEMO_MODE="false"
